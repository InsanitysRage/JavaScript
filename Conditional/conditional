<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Aged Based Content</title>
</head>

<body>
  <div id="content">
    <p id="adultContent" style="display: none">
      Welcome to the adult section!
    </p>
    <p id="minorContent" style="display: none">
      Welcome to the minor section!
    </p>
  </div>
  <script>
    var myAge = 18;
    if (myAge >= 18) {
      document.getElementById("adultContent").style.display = "block";
    } else {
      document.getElementById("minorContent").style.display = "block";
    }
  </script>
</body>

</html>
